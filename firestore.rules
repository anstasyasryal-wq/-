rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSupervisor() {
      return (
        request.auth != null && (
          request.auth.token.email == 'anstasyasryal@gmail.com' ||
          request.auth.token.role == 'supervisor' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor')
        )
      ) || (
        request.resource != null &&
        request.resource.data.role == 'supervisor' &&
        request.resource.data.code == 'ADMIN'
      );
    }

    // 1. Users collection:
    // Read: public (required for real-time leaderboard)
    // Create: self-registration, role restricted to participant
    // Update: profile updates only, role changes forbidden, score bounds strictly checked
    // Delete: supervisor or cleanup of test items
    match /users/{userId} {
      allow read: if true;
      allow create: if (
        (!('role' in request.resource.data) || request.resource.data.role == 'participant') ||
        isSupervisor()
      );
      allow update: if (
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('totalPoints' in request.resource.data) || (request.resource.data.totalPoints is number && request.resource.data.totalPoints >= 0 && request.resource.data.totalPoints <= 1500)) &&
        (!('correctAnswersCount' in request.resource.data) || (request.resource.data.correctAnswersCount is number && request.resource.data.correctAnswersCount >= 0 && request.resource.data.correctAnswersCount <= 70)) &&
        (!('currentStageId' in request.resource.data) || (request.resource.data.currentStageId is number && request.resource.data.currentStageId >= 1 && request.resource.data.currentStageId <= 7))
      ) || isSupervisor();
      allow delete: if isSupervisor() || userId.matches('test_.*') || resource.data.code.matches('.*TEST.*');
    }

    // 2. Stages collection:
    // Read: public (competition syllabus & schedule)
    // Write: supervisor or initial seed
    match /stages/{stageId} {
      allow read: if true;
      allow write: if isSupervisor() || !exists(/databases/$(database)/documents/stages/$(stageId));
    }

    // 3. Question Bank in Firestore:
    // SECURED: Raw questions with correct answers CANNOT be read directly by participants.
    // Participants receive sanitized questions through the server proxy (/api/stage-questions/:stageId).
    match /questions/{questionId} {
      allow read, write: if isSupervisor() || !exists(/databases/$(database)/documents/questions/$(questionId));
    }

    // 4. Attempts collection:
    // SECURED AGAINST FORGERY AND DUPLICATES:
    match /attempts/{attemptId} {
      allow read: if true;
      allow create: if
        attemptId == request.resource.data.userId + '_stage_' + string(request.resource.data.stageId) &&
        !exists(/databases/$(database)/documents/attempts/$(attemptId)) &&
        (request.resource.data.stageId is int && request.resource.data.stageId >= 1 && request.resource.data.stageId <= 6) &&
        (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 350) &&
        (request.resource.data.correctCount is int && request.resource.data.correctCount >= 0 && request.resource.data.correctCount <= 25) &&
        (request.resource.data.totalTimeSpent is number && request.resource.data.totalTimeSpent >= 5 && request.resource.data.totalTimeSpent <= 600);
      allow update: if isSupervisor();
      allow delete: if isSupervisor() || attemptId.matches('test_.*');
    }

    // 5. Announcements:
    // Read: public
    // Write: supervisor or initial seed
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isSupervisor() || !exists(/databases/$(database)/documents/announcements/$(announcementId));
    }
  }
}
